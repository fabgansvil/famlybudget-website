---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="FamlyBudget — Family finances, finally under control"
  description="FamlyBudget — Track income and expenses, manage shared budgets and sync your entire household in real time. Free to start."
>

  <!-- ══════════ HERO ══════════ -->
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-eyebrow" data-i18n="hero_eyebrow">✦ New 2026</div>
        <h1 data-i18n-html="hero_h1">Family finances,<br /><span>finally under control</span></h1>
        <p class="hero-sub" data-i18n="hero_sub">Track income and expenses, manage shared budgets, visualize clear charts and sync your entire household in real time.</p>
        <div class="hero-buttons">
          <a href="#download" class="gplay-badge" id="download">
            <span class="badge-icon">▶</span>
            <span class="badge-text">
              <span class="badge-sub" data-i18n="hero_badge_sub">Get it on</span>
              <span class="badge-store" data-i18n="hero_badge_store">Google Play</span>
            </span>
          </a>
          <a href="#features" class="btn btn-secondary btn-lg" data-i18n="hero_explore">Explore features</a>
        </div>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-num" data-i18n="stat1_num">100%</span>
            <span class="stat-label" data-i18n="stat1_label">Free to start</span>
          </div>
          <div class="stat">
            <span class="stat-num" data-i18n="stat2_num">5 languages</span>
            <span class="stat-label" data-i18n="stat2_label">IT · EN · ES · FR · HE</span>
          </div>
          <div class="stat">
            <span class="stat-num" data-i18n="stat3_num">Offline</span>
            <span class="stat-label" data-i18n="stat3_label">Works without internet</span>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <div class="phone-float-card phone-float-1">
          <div class="fc-label" data-i18n="phone_float1_label">Monthly savings</div>
          <div class="fc-val">+ €300</div>
        </div>
        <div class="phone-real">
          <img src="/screens/en/01-dashboard.webp" data-src-en="/screens/en/01-dashboard.webp" data-src-it="/screens/01-dashboard.webp" width="640" height="1387" fetchpriority="high"
               alt="FamlyBudget dashboard" data-i18n-alt="hero_img_alt" />
        </div>
        <div class="phone-float-card phone-float-2">
          <div class="phone-float-2-icon">🎯</div>
          <div class="phone-float-2-text">
            <div class="fc-label" data-i18n="phone_float2_label">Vacation goal</div>
            <div class="fc-val">€ 1,150 / €3,000</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ FEATURES ══════════ -->
  <section class="section" id="features">
    <div class="container">
      <div class="section-header">
        <div class="badge" data-i18n="feat_badge">✦ Features</div>
        <h2 data-i18n="feat_h2">Everything you need to manage the family budget</h2>
        <p data-i18n="feat_p">A complete yet simple tool, designed for real everyday life.</p>
      </div>
      <div class="features-grid">

        <div class="feature-card">
          <div class="feature-icon">📊</div>
          <div class="feature-body">
            <h3 data-i18n="feat1_h3">Charts &amp; Reports</h3>
            <p data-i18n="feat1_p">Analyze income and expenses with interactive monthly charts and discover exactly where your money goes.</p>
            <ul class="feature-bullets">
              <li data-i18n="feat1_b1">Monthly bar charts with account and category filters</li>
              <li data-i18n="feat1_b2">90-day balance projection</li>
              <li data-i18n="feat1_b3">CSV and PDF data export (Premium)</li>
            </ul>
          </div>
        </div>

        <div class="feature-card">
          <div class="feature-icon">☁️</div>
          <div class="feature-body">
            <h3 data-i18n="feat2_h3">Real-time Cloud Sync</h3>
            <p data-i18n="feat2_p">Data syncs instantly across all household devices. Always up to date, wherever you are.</p>
            <ul class="feature-bullets">
              <li data-i18n="feat2_b1">Real-time updates without reloading</li>
              <li data-i18n="feat2_b2">Available in the Premium Cloud plan</li>
              <li data-i18n="feat2_b3">Offline mode: the app works without internet</li>
            </ul>
          </div>
        </div>

        <div class="feature-card">
          <div class="feature-icon">👨‍👩‍👧</div>
          <div class="feature-body">
            <h3 data-i18n="feat3_h3">Family Multi-user</h3>
            <p data-i18n="feat3_p">Invite family members and manage the budget together, each from their own smartphone.</p>
            <ul class="feature-bullets">
              <li data-i18n="feat3_b1">Up to 10 members in Premium Cloud plan</li>
              <li data-i18n="feat3_b2">Each member adds expenses in real time</li>
              <li data-i18n="feat3_b3">Shared view of accounts and transactions</li>
            </ul>
          </div>
        </div>

        <div class="feature-card">
          <div class="feature-icon">💳</div>
          <div class="feature-body">
            <h3 data-i18n="feat4_h3">Accounts &amp; Credit Cards</h3>
            <p data-i18n="feat4_p">Keep track of all your financial tools in one place, with always up-to-date balances.</p>
            <ul class="feature-bullets">
              <li data-i18n="feat4_b1">Current accounts, cash, savings accounts</li>
              <li data-i18n="feat4_b2">Credit cards with statement and billing dates</li>
              <li data-i18n="feat4_b3">Balance adjustable with opening date</li>
            </ul>
          </div>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🎯</div>
          <div class="feature-body">
            <h3 data-i18n="feat5_h3">Savings Goals</h3>
            <p data-i18n="feat5_p">Set financial milestones and monitor progress over time, contribution by contribution.</p>
            <ul class="feature-bullets">
              <li data-i18n="feat5_b1">Holidays, purchases, emergency funds</li>
              <li data-i18n="feat5_b2">Manual contributions with history</li>
              <li data-i18n="feat5_b3">Visual progress bar with completion %</li>
            </ul>
          </div>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🔁</div>
          <div class="feature-body">
            <h3 data-i18n="feat6_h3">Recurring Transactions</h3>
            <p data-i18n="feat6_p">Subscriptions, salaries and rent generate automatically. Never miss an expense again.</p>
            <ul class="feature-bullets">
              <li data-i18n="feat6_b1">Automatic generation at due date</li>
              <li data-i18n="feat6_b2">Installment support with payment plans</li>
              <li data-i18n="feat6_b3">Up to 4 recurring in Free plan, unlimited in Premium</li>
            </ul>
          </div>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🏦</div>
          <div class="feature-body">
            <h3 data-i18n="feat7_h3">Monthly Budgets</h3>
            <p data-i18n="feat7_p">Set a budget for each category and monitor in real time how much you have already spent against the limit.</p>
            <ul class="feature-bullets">
              <li data-i18n="feat7_b1">Budget per category with overspending alerts</li>
              <li data-i18n="feat7_b2">Spent vs planned comparison</li>
              <li data-i18n="feat7_b3">Month-by-month budget history</li>
            </ul>
          </div>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🔒</div>
          <div class="feature-body">
            <h3 data-i18n="feat8_h3">Privacy &amp; Security</h3>
            <p data-i18n="feat8_p">Your financial data is protected. You can choose to never send it to the cloud if you prefer maximum privacy.</p>
            <ul class="feature-bullets">
              <li data-i18n="feat8_b1">App lock with fingerprint or Face ID</li>
              <li data-i18n="feat8_b2">Local mode: data only on device</li>
              <li data-i18n="feat8_b3">No financial data shared with third parties</li>
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════ SCREENSHOTS ══════════ -->
  <section class="section section-alt" id="screenshots">
    <div class="container">
      <div class="section-header">
        <div class="badge" data-i18n="ss_badge">✦ Interface</div>
        <h2 data-i18n="ss_h2">An interface designed for simplicity</h2>
        <p data-i18n="ss_p">Clean, fast, intuitive. All the important information always at your fingertips.</p>
      </div>
    </div>
    <div class="shots-scroller" tabindex="0" role="region" aria-label="FamlyBudget screenshots" data-i18n-aria="ss_region">
      <ul class="shots-track">
        <li class="shot">
          <div class="shot-frame"><img src="/screens/en/01-dashboard.webp" data-src-en="/screens/en/01-dashboard.webp" data-src-it="/screens/01-dashboard.webp" width="640" height="1387" loading="lazy" alt="" data-i18n-alt="ss_alt1" /></div>
          <div class="caption" data-i18n="ss_cap1"></div>
        </li>
        <li class="shot">
          <div class="shot-frame"><img src="/screens/en/02-add.webp" data-src-en="/screens/en/02-add.webp" data-src-it="/screens/02-add.webp" width="640" height="1387" loading="lazy" alt="" data-i18n-alt="ss_alt2" /></div>
          <div class="caption" data-i18n="ss_cap2"></div>
        </li>
        <li class="shot">
          <div class="shot-frame"><img src="/screens/en/03-transactions.webp" data-src-en="/screens/en/03-transactions.webp" data-src-it="/screens/03-transactions.webp" width="640" height="1387" loading="lazy" alt="" data-i18n-alt="ss_alt3" /></div>
          <div class="caption" data-i18n="ss_cap3"></div>
        </li>
        <li class="shot">
          <div class="shot-frame"><img src="/screens/en/04-budget.webp" data-src-en="/screens/en/04-budget.webp" data-src-it="/screens/04-budget.webp" width="640" height="1387" loading="lazy" alt="" data-i18n-alt="ss_alt4" /></div>
          <div class="caption" data-i18n="ss_cap4"></div>
        </li>
        <li class="shot">
          <div class="shot-frame"><img src="/screens/en/05-survival.webp" data-src-en="/screens/en/05-survival.webp" data-src-it="/screens/05-survival.webp" width="640" height="1387" loading="lazy" alt="" data-i18n-alt="ss_alt5" /></div>
          <div class="caption" data-i18n="ss_cap5"></div>
        </li>
        <li class="shot">
          <div class="shot-frame"><img src="/screens/en/06-accounts.webp" data-src-en="/screens/en/06-accounts.webp" data-src-it="/screens/06-accounts.webp" width="640" height="1387" loading="lazy" alt="" data-i18n-alt="ss_alt6" /></div>
          <div class="caption" data-i18n="ss_cap6"></div>
        </li>
        <li class="shot">
          <div class="shot-frame"><img src="/screens/en/07-goals.webp" data-src-en="/screens/en/07-goals.webp" data-src-it="/screens/07-goals.webp" width="640" height="1387" loading="lazy" alt="" data-i18n-alt="ss_alt7" /></div>
          <div class="caption" data-i18n="ss_cap7"></div>
        </li>
        <li class="shot">
          <div class="shot-frame"><img src="/screens/en/08-reports.webp" data-src-en="/screens/en/08-reports.webp" data-src-it="/screens/08-reports.webp" width="640" height="1387" loading="lazy" alt="" data-i18n-alt="ss_alt8" /></div>
          <div class="caption" data-i18n="ss_cap8"></div>
        </li>
        <li class="shot">
          <div class="shot-frame"><img src="/screens/en/09-calendar.webp" data-src-en="/screens/en/09-calendar.webp" data-src-it="/screens/09-calendar.webp" width="640" height="1387" loading="lazy" alt="" data-i18n-alt="ss_alt9" /></div>
          <div class="caption" data-i18n="ss_cap9"></div>
        </li>
      </ul>
    </div>
    <p class="shots-note" data-i18n="ss_note">Screenshots show the app with sample data.</p>
  </section>

  <!-- ══════════ WEB APP ══════════ -->
  <section class="section" id="webapp">
    <div class="container">
      <div class="section-header">
        <div class="badge" data-i18n="wa_badge">✦ Web app</div>
        <h2 data-i18n="wa_h2">Also on your computer</h2>
        <p data-i18n="wa_p">Sign in from any browser with your FamlyBudget account and find the same data, in a layout designed for large screens. Available when your data is stored in the cloud.</p>
      </div>
    </div>
    <div class="shots-scroller" tabindex="0" role="region" aria-label="FamlyBudget web app screenshots" data-i18n-aria="wa_region">
      <ul class="shots-track">
        <li class="wshot">
          <div class="web-frame">
            <div class="web-bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <img src="/screens/web/01-dashboard.webp" width="1600" height="1011" loading="lazy" alt="" data-i18n-alt="wa_alt1" />
          </div>
          <div class="caption" data-i18n="wa_cap1"></div>
        </li>
        <li class="wshot">
          <div class="web-frame">
            <div class="web-bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <img src="/screens/web/02-transactions.webp" width="1600" height="1000" loading="lazy" alt="" data-i18n-alt="wa_alt2" />
          </div>
          <div class="caption" data-i18n="wa_cap2"></div>
        </li>
        <li class="wshot">
          <div class="web-frame">
            <div class="web-bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <img src="/screens/web/03-budgets.webp" width="1600" height="1011" loading="lazy" alt="" data-i18n-alt="wa_alt3" />
          </div>
          <div class="caption" data-i18n="wa_cap3"></div>
        </li>
        <li class="wshot">
          <div class="web-frame">
            <div class="web-bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <img src="/screens/web/04-accounts.webp" width="1600" height="1011" loading="lazy" alt="" data-i18n-alt="wa_alt4" />
          </div>
          <div class="caption" data-i18n="wa_cap4"></div>
        </li>
        <li class="wshot">
          <div class="web-frame">
            <div class="web-bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <img src="/screens/web/05-reports.webp" width="1600" height="1011" loading="lazy" alt="" data-i18n-alt="wa_alt5" />
          </div>
          <div class="caption" data-i18n="wa_cap5"></div>
        </li>
        <li class="wshot">
          <div class="web-frame">
            <div class="web-bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <img src="/screens/web/06-calendar.webp" width="1600" height="1000" loading="lazy" alt="" data-i18n-alt="wa_alt6" />
          </div>
          <div class="caption" data-i18n="wa_cap6"></div>
        </li>
        <li class="wshot">
          <div class="web-frame">
            <div class="web-bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <img src="/screens/web/07-projection.webp" width="1600" height="1011" loading="lazy" alt="" data-i18n-alt="wa_alt7" />
          </div>
          <div class="caption" data-i18n="wa_cap7"></div>
        </li>
      </ul>
    </div>
    <p class="shots-note" data-i18n="wa_note">Screenshots show the web app with sample data.</p>
  </section>

  <!-- ══════════ PRICING ══════════ -->
  <section class="section" id="pricing">
    <div class="container">
      <div class="section-header">
        <div class="badge" data-i18n="pr_badge">✦ Pricing</div>
        <h2 data-i18n="pr_h2">Choose the right plan for you</h2>
        <p data-i18n="pr_p">Start for free. Choose Premium based on how you want to store your data.</p>
      </div>
      <div class="pricing-grid">

        <div class="pricing-card wide">
          <div class="pricing-name" data-i18n="pr_free_name">Free</div>
          <div class="pricing-price">€0<span data-i18n="pr_free_price_suffix">/month</span></div>
          <div class="pricing-yearly" data-i18n="pr_free_yearly">Free forever</div>
          <div class="pricing-divider"></div>
          <ul class="pricing-features cols">
            <li data-i18n-html="pr_free_f1"><span class="ico">📍</span><span>Local or cloud storage</span></li>
            <li data-i18n-html="pr_free_f2"><span class="ico">🎯</span><span>Budgets with alerts</span></li>
            <li data-i18n-html="pr_free_f3"><span class="ico">🐷</span><span>Savings goals</span></li>
            <li data-i18n-html="pr_free_f4"><span class="ico">💳</span><span>Cards &amp; installments</span></li>
            <li data-i18n-html="pr_free_f5"><span class="ico">🔁</span><span>Recurring transactions</span></li>
            <li data-i18n-html="pr_free_f6"><span class="ico">📅</span><span>Calendar &amp; tasks</span></li>
            <li data-i18n-html="pr_free_f7"><span class="ico">🔮</span><span>90-day projection</span></li>
            <li data-i18n-html="pr_free_f8"><span class="ico">📊</span><span>Reports &amp; net worth</span></li>
            <li data-i18n-html="pr_free_f9"><span class="ico">📥</span><span>Bank import CSV/XLSX</span></li>
            <li data-i18n-html="pr_free_f10"><span class="ico">✅</span><span>Statement reconciliation</span></li>
            <li data-i18n-html="pr_free_f11"><span class="ico">💱</span><span>Multi-currency &amp; tags</span></li>
            <li data-i18n-html="pr_free_f12"><span class="ico">🧾</span><span>Receipt photos</span></li>
            <li data-i18n-html="pr_free_f13"><span class="ico">🧩</span><span>17 dashboard widgets + Android home</span></li>
            <li data-i18n-html="pr_free_f14"><span class="ico">🔒</span><span>Biometric lock &amp; 2FA</span></li>
          </ul>
          <div class="pricing-note" data-i18n-html="pr_free_note"><b>Also included:</b> 112 ready-made categories · 5 languages · dark theme<br><b>Limits:</b> 80 transactions/month · 3 accounts · 4 recurring · +15 categories · +1 currency · 1 invited member</div>
          <ul class="pricing-features cols" style="flex:0;margin-bottom:24px">
            <li class="muted" data-i18n-html="pr_free_x1"><span class="cross">✕</span><span>Data export</span></li>
            <li class="muted" data-i18n-html="pr_free_x2"><span class="cross">✕</span><span>Backup &amp; Restore</span></li>
            <li class="muted" data-i18n-html="pr_free_x3"><span class="cross">✕</span><span>History &gt; 12 months</span></li>
          </ul>
          <a href="#download" class="btn btn-secondary" style="width:100%;justify-content:center;margin-top:auto;" data-i18n="pr_free_btn">Start Free</a>
        </div>

        <div class="pricing-card">
          <div class="pricing-name" data-i18n="pr_local_name">Premium Local</div>
          <div class="pricing-price">€2<span data-i18n="pr_local_price_suffix">/month</span></div>
          <div class="pricing-yearly" data-i18n-html="pr_local_yearly">or <strong>€15/year — save 38%</strong></div>
          <div class="pricing-divider"></div>
          <div style="display:flex;align-items:center;gap:8px;background:var(--neutral);border-radius:10px;padding:10px 12px;margin-bottom:16px;">
            <span style="font-size:22px;">📱</span>
            <div>
              <div style="font-size:12px;font-weight:700;color:var(--text);" data-i18n="pr_local_badge_title">Data on device</div>
              <div style="font-size:11px;color:var(--text-muted);" data-i18n="pr_local_badge_sub">Your data stays only on the device — no financial data in the cloud</div>
            </div>
          </div>
          <ul class="pricing-features">
            <li class="lead" data-i18n="pr_local_lead">Everything in Free, plus:</li>
            <li data-i18n-html="pr_local_f1"><span class="check">✓</span> Unlimited transactions</li>
            <li data-i18n-html="pr_local_f2"><span class="check">✓</span> Up to 20 active accounts</li>
            <li data-i18n-html="pr_local_f3"><span class="check">✓</span> Unlimited recurring transactions</li>
            <li data-i18n-html="pr_local_f4"><span class="check">✓</span> +150 categories, +10 currencies</li>
            <li data-i18n-html="pr_local_f5"><span class="check">✓</span> CSV/XLSX &amp; PDF export</li>
            <li data-i18n-html="pr_local_f6"><span class="check">✓</span> Chart history up to 24 months &amp; “All”</li>
            <li data-i18n-html="pr_local_f7"><span class="check">✓</span> Backup &amp; Restore</li>
            <li class="muted" data-i18n-html="pr_local_f8"><span class="cross">✕</span> Multi-device sync</li>
            <li class="muted" data-i18n-html="pr_local_f9"><span class="cross">✕</span> Family sharing</li>
          </ul>
          <a href="#download" class="btn btn-secondary" style="width:100%;justify-content:center;margin-top:auto;" data-i18n="pr_local_btn">Choose Local</a>
        </div>

        <div class="pricing-card featured">
          <div class="most-popular" data-i18n="pr_cloud_popular">⭐ Most complete</div>
          <div class="pricing-name" data-i18n="pr_cloud_name">Premium Cloud</div>
          <div class="pricing-price">€2<span style="font-size:18px;font-weight:500;color:var(--text-muted);" data-i18n="pr_cloud_price_suffix">,99/month</span></div>
          <div class="pricing-yearly" data-i18n-html="pr_cloud_yearly">or <strong>€21.99/year — save 39%</strong></div>
          <div class="pricing-divider"></div>
          <div style="display:flex;align-items:center;gap:8px;background:var(--blue-light);border-radius:10px;padding:10px 12px;margin-bottom:16px;">
            <span style="font-size:22px;">☁️</span>
            <div>
              <div style="font-size:12px;font-weight:700;color:var(--blue-dark);" data-i18n="pr_cloud_badge_title">Real-time sync across all devices</div>
              <div style="font-size:11px;color:var(--blue);" data-i18n="pr_cloud_badge_sub">Cloud synchronization</div>
            </div>
          </div>
          <ul class="pricing-features">
            <li class="lead" data-i18n="pr_cloud_lead">Everything in Premium Local, plus:</li>
            <li data-i18n-html="pr_cloud_f2"><span class="check">✓</span> Real-time multi-device sync</li>
            <li data-i18n-html="pr_cloud_f3"><span class="check">✓</span> Family sharing (up to 10)</li>
            <li data-i18n-html="pr_cloud_f4"><span class="check">✓</span> Browser access (web dashboard)</li>
