<style>
  /* Hero: schermata reale in cornice */
  .phone-real { width: 290px; border: 10px solid #1E3A8A; border-radius: 46px; overflow: hidden; background: #fff;
    box-shadow: 0 32px 80px rgba(30,58,138,0.25), 0 4px 16px rgba(0,0,0,0.1); position: relative; }
  .phone-real img { width: 100%; height: auto; }

  /* Galleria screenshot: scorrimento orizzontale con snap */
  .shots-scroller { overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
    padding: 12px 0 28px; scrollbar-width: thin; scrollbar-color: #94A3B8 transparent; outline-offset: -4px; }
  .shots-track { list-style: none; display: flex; gap: 28px; width: max-content; margin: 0 auto;
    padding: 0 max(24px, calc((100vw - 1120px) / 2 + 24px)); }
  .shot { scroll-snap-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px; width: 250px; }
  .shot-frame { width: 250px; border: 8px solid #1E3A8A; border-radius: 36px; overflow: hidden; background: #fff;
    box-shadow: var(--shadow-lg); transition: transform 0.3s; }
  .shot-frame:hover { transform: translateY(-8px); }
  .shot-frame img { width: 100%; height: auto; }
  .shot .caption { font-size: 14px; font-weight: 600; color: var(--text); text-align: center; max-width: 240px; line-height: 1.4; }
  .shots-note { text-align: center; font-size: 12px; color: var(--text-muted); margin-top: 4px; padding: 0 24px; }
  @media (max-width: 768px) {
    .shots-track { gap: 18px; }
    .shot, .shot-frame { width: 210px; }
    .shot-frame { border-width: 6px; border-radius: 30px; }
  }
  @media (prefers-reduced-motion: reduce) { .shot-frame { transition: none; } .shot-frame:hover { transform: none; } }
  /* Web app: schermate in una finestra di browser */
  .wshot { scroll-snap-align: center; display: flex; flex-direction: column; align-items: center; gap: 16px; width: 560px; }
  .web-frame { width: 560px; border: 1px solid #CBD5E1; border-radius: 12px; overflow: hidden; background: #fff;
    box-shadow: var(--shadow-lg); transition: transform 0.3s; }
  .web-frame:hover { transform: translateY(-6px); }
  .web-bar { display: flex; gap: 6px; padding: 9px 12px; background: #F1F5F9; border-bottom: 1px solid #E2E8F0; }
  .web-bar span { width: 10px; height: 10px; border-radius: 50%; background: #CBD5E1; }
  .web-frame img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
  .wshot .caption { font-size: 14px; font-weight: 600; color: var(--text); text-align: center; max-width: 480px; line-height: 1.4; }
  @media (max-width: 768px) {
    .wshot, .web-frame { width: 320px; }
  }
  @media (prefers-reduced-motion: reduce) { .web-frame { transition: none; } .web-frame:hover { transform: none; } }
</style>

